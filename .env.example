# Set these in Netlify: Site configuration > Environment variables. For local testing, copy to .env. Never commit real values.
ANTHROPIC_API_KEY=
# Strongly recommended: without it, anyone who finds your URL can spend your API credit.
APP_PASSCODE=
# Check the current model names in Anthropic's docs and change this if you want a different one.
ANTHROPIC_MODEL=claude-sonnet-5-5
MAX_TOKENS=700
RATE_LIMIT_PER_MIN=20
DAILY_LIMIT=500
